# Copy to .env.local for local development. Never commit real values.

# ---------- App ----------
APP_URL=http://localhost:3000
# Comma-separated emails that get the admin role on sign-up / sign-in.
ADMIN_EMAILS=

# ---------- Demo mode ----------
# Defaults: on in development, OFF in production.
TRENDSAATHI_DEMO_MODE=true
# Production ignores TRENDSAATHI_DEMO_MODE unless this is also true (public demo deployments only).
TRENDSAATHI_ALLOW_DEMO_IN_PRODUCTION=false

# ---------- Database ----------
# Leave empty for embedded PGlite stored in ./.data/pglite (local dev / demo). Required in production
# (free option: Neon). Production refuses the embedded DB unless TRENDSAATHI_ALLOW_EMBEDDED_DB_IN_PRODUCTION=true.
# Production: a Postgres connection string (e.g. Supabase "Session pooler" URI).
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite
# DATABASE_SSL=false            # only for a local Postgres without TLS
# DATABASE_SSL_STRICT=false     # allow self-signed certs (not recommended)
# DATABASE_POOL_MAX=10

# ---------- AI provider selection ----------
# groq (alias of openai_compatible) | anthropic | ollama | template. Leave empty for the default: Anthropic when configured, otherwise the
# labeled template preview. "ollama" never falls back to the template: if Ollama is down you get an error.
AI_PROVIDER=

# ---------- Open-source AI via an OpenAI-compatible host (free: Groq) — recommended for production ----------
# Get a free key at https://console.groq.com. Works with OpenRouter / Together / self-hosted vLLM too.
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=openai/gpt-oss-20b
# json_schema (strict, Groq gpt-oss/Qwen) | json_object (hosts without schema support)
OPENAI_COMPAT_JSON_MODE=json_schema
# low | medium | high | none — only for reasoning models such as gpt-oss (default low = fast)
OPENAI_COMPAT_REASONING_EFFORT=
OPENAI_COMPAT_TIMEOUT_MS=60000
OPENAI_COMPAT_MAX_OUTPUT_TOKENS=3000

# ---------- Local AI (Ollama, free, development only) ----------
# Install from https://ollama.com/download, then: ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# CPU inference is slow; these are generous on purpose.
OLLAMA_TIMEOUT_MS=180000
OLLAMA_NUM_CTX=4096
# Upper cap; captions use 600–1500 depending on requested length and script.
OLLAMA_MAX_OUTPUT_TOKENS=1500

# ---------- Live AI (Anthropic) ----------
# Both are required for live caption/brief generation. Without them the app shows a labeled template preview.
ANTHROPIC_API_KEY=
# Use a current model id from https://platform.claude.com/docs/en/about-claude/models (e.g. claude-opus-5-5).
ANTHROPIC_MODEL=
# low | medium | high | omit (omit = don't send the effort parameter)
ANTHROPIC_EFFORT=low
# default | off — server-side refusal fallback (beta). Models that don't support it run alone.
ANTHROPIC_FALLBACKS=default
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=8000
AI_MAX_INPUT_CHARS=4000

# ---------- Usage limits ----------
AI_REQUESTS_PER_USER_PER_MINUTE=6
AI_REQUESTS_PER_USER_PER_DAY=40
DEMO_AI_REQUESTS_PER_USER_PER_DAY=10
AUTH_ATTEMPTS_PER_IP_PER_15_MIN=20

# ---------- Trend sources ----------
# Wikimedia pageviews (no key). Requires a descriptive User-Agent with contact info.
SOURCE_WIKIMEDIA_ENABLED=false
WIKIMEDIA_USER_AGENT=
# Google Trends "Trending now" RSS for India (official export, no key, no cookies). Search interest only.
SOURCE_GOOGLE_TRENDS_RSS_ENABLED=false
# User-Agent for keyless feeds; include a contact URL for your deployment.
TRENDSAATHI_USER_AGENT=
# YouTube Data API v3 key (Google Cloud). Enables the Most Popular (IN) chart sample.
YOUTUBE_API_KEY=

# ---------- Ingestion endpoint ----------
# Bearer secret (>= 32 chars) for POST /api/jobs/ingest (scheduler / cron). Generate with: openssl rand -hex 32
INGEST_SECRET=
